# Local development
# Normal local development uses the checked-in config defaults:
# - PostgreSQL on localhost:5432
# - username/password postgres/postgres
# - databases jido_code_dev and jido_code_test*
# Leave DATABASE_URL unset for mix setup, mix phx.server, and mix test.
DATABASE_URL=

# Phoenix/runtime overrides
SECRET_KEY_BASE=
JIDO_CODE_SECRET_REF_ENCRYPTION_KEY=  # base64-encoded 32-byte key
PORT=4000
PHX_HOST=
CANONICAL_HOST=  # Optional

# Email (Resend)
RESEND_API_KEY=
MAILER_FROM_EMAIL=noreply@yourdomain.com
