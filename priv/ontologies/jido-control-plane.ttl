jcp:reviewPolicyId a owl:DatatypeProperty ;
    rdfs:label "review policy id" ;
    rdfs:domain jcp:ReviewPolicy ;
    rdfs:range xsd:string .

jcp:repoPostureId a owl:DatatypeProperty ;
    rdfs:label "repository posture id" ;
    rdfs:domain jcp:RepoPosture ;
    rdfs:range xsd:string .

jcp:postureCheckId a owl:DatatypeProperty ;
    rdfs:label "posture check id" ;
    rdfs:domain jcp:PostureCheck ;
    rdfs:range xsd:string .

jcp:conversationId a owl:DatatypeProperty ;
    rdfs:label "conversation id" ;
    rdfs:domain jcp:Conversation ;
    rdfs:range xsd:string .

jcp:conversationEventId a owl:DatatypeProperty ;
    rdfs:label "conversation event id" ;
    rdfs:domain jcp:ConversationEvent ;
    rdfs:range xsd:string .

jcp:conversationSnapshotId a owl:DatatypeProperty ;
    rdfs:label "conversation snapshot id" ;
    rdfs:domain jcp:ConversationSnapshot ;
    rdfs:range xsd:string .

jcp:executionWorkflowId a owl:DatatypeProperty ;
    rdfs:label "execution workflow id" ;
    rdfs:domain jcp:ExecutionWorkflow ;
    rdfs:range xsd:string .

jcp:sandboxSessionId a owl:DatatypeProperty ;
    rdfs:label "sandbox session id" ;
    rdfs:domain jcp:SandboxSession ;
    rdfs:range xsd:string .

jcp:runtimeEventId a owl:DatatypeProperty ;
    rdfs:label "runtime event id" ;
    rdfs:domain jcp:RuntimeEvent ;
    rdfs:range xsd:string .

jcp:checkpointId a owl:DatatypeProperty ;
    rdfs:label "checkpoint id" ;
