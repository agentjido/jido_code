### Orchestration and governance datatype properties

jcp:sourceRunId a owl:DatatypeProperty ;
    rdfs:label "source run id" ;
    rdfs:comment "Human or workflow supplied run identifier distinct from the canonical Run record id." ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:runWorkflowRunId a owl:DatatypeProperty ;
    rdfs:label "run workflow run id" ;
    rdfs:comment "Class-scoped identity predicate linking a canonical Run to its compatibility WorkflowRun id." ;
    rdfs:domain jcp:Run ;
    rdfs:range xsd:string .

jcp:runSourceKey a owl:DatatypeProperty ;
    rdfs:label "run source key" ;
    rdfs:comment "Class-scoped natural identity for a Run derived from managed repo and source run id." ;
    rdfs:domain jcp:Run ;
    rdfs:range xsd:string .

jcp:executionProfileSourceKey a owl:DatatypeProperty ;
    rdfs:label "execution profile source key" ;
    rdfs:comment "Class-scoped natural identity for an ExecutionProfile derived from managed repo and profile name." ;
    rdfs:domain jcp:ExecutionProfile ;
    rdfs:range xsd:string .

jcp:evidenceKey a owl:DatatypeProperty ;
    rdfs:label "evidence key" ;
    rdfs:domain jcp:Evidence ;
    rdfs:range xsd:string .

jcp:evidenceSourceKey a owl:DatatypeProperty ;
    rdfs:label "evidence source key" ;
    rdfs:comment "Class-scoped natural identity for Evidence derived from run and evidence key." ;
    rdfs:domain jcp:Evidence ;
    rdfs:range xsd:string .

jcp:changeRequestSourceKey a owl:DatatypeProperty ;
    rdfs:label "change request source key" ;
    rdfs:comment "Class-scoped natural identity for a ChangeRequest, normally the governed run id." ;
    rdfs:domain jcp:ChangeRequest ;
    rdfs:range xsd:string .

jcp:policySetSourceKey a owl:DatatypeProperty ;
    rdfs:label "policy set source key" ;
    rdfs:comment "Class-scoped natural identity for a PolicySet derived from managed repo and policy name." ;
    rdfs:domain jcp:PolicySet ;
    rdfs:range xsd:string .

jcp:repoPostureSourceKey a owl:DatatypeProperty ;
    rdfs:label "repository posture source key" ;
    rdfs:comment "Class-scoped natural identity for a RepoPosture, normally the managed repo id." ;
    rdfs:domain jcp:RepoPosture ;
    rdfs:range xsd:string .

jcp:postureCheckSourceKey a owl:DatatypeProperty ;
    rdfs:label "posture check source key" ;
    rdfs:comment "Class-scoped natural identity for a PostureCheck derived from managed repo and dimension." ;
    rdfs:domain jcp:PostureCheck ;
    rdfs:range xsd:string .

jcp:workflowName a owl:DatatypeProperty ;
    rdfs:label "workflow name" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:workflowVersion a owl:DatatypeProperty ;
    rdfs:label "workflow version" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:integer .

jcp:currentStep a owl:DatatypeProperty ;
    rdfs:label "current step" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:currentStage a owl:DatatypeProperty ;
    rdfs:label "current stage" ;
    rdfs:domain jcp:Run ;
    rdfs:range xsd:string .

jcp:governedStagesJson a owl:DatatypeProperty ;
    rdfs:label "governed stages JSON" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:stageStatusesJson a owl:DatatypeProperty ;
