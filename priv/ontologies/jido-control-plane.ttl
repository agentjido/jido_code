jcp:spriteSpecId a owl:DatatypeProperty ;
    rdfs:label "sprite spec id" ;
    rdfs:domain jcp:SpriteSpec ;
    rdfs:range xsd:string .

jcp:userId a owl:DatatypeProperty ;
    rdfs:label "user id" ;
    rdfs:domain jcp:User ;
    rdfs:range xsd:string .

jcp:userIdentityId a owl:DatatypeProperty ;
    rdfs:label "user identity id" ;
    rdfs:domain jcp:UserIdentity ;
    rdfs:range xsd:string .

jcp:apiKeyId a owl:DatatypeProperty ;
    rdfs:label "API key id" ;
    rdfs:domain jcp:ApiKey ;
    rdfs:range xsd:string .

jcp:tokenId a owl:DatatypeProperty ;
    rdfs:label "token id" ;
    rdfs:domain jcp:Token ;
    rdfs:range xsd:string .

jcp:providerConfigId a owl:DatatypeProperty ;
    rdfs:label "provider config id" ;
