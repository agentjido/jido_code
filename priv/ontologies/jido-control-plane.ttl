jcp:githubRepoId a owl:DatatypeProperty ;
    rdfs:label "GitHub repository id" ;
    rdfs:domain jcp:GitHubRepo ;
    rdfs:range xsd:string .

jcp:webhookDeliveryId a owl:DatatypeProperty ;
    rdfs:label "webhook delivery id" ;
    rdfs:domain jcp:WebhookDelivery ;
    rdfs:range xsd:string .

jcp:issueAnalysisId a owl:DatatypeProperty ;
    rdfs:label "issue analysis id" ;
    rdfs:domain jcp:IssueAnalysis ;
