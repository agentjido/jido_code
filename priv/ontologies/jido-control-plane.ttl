# covers: architecture.factory_control_plane.semantic_repository_insights_rejoin_control_plane
# covers: architecture.memory_ontology.companion_control_plane_ontology_models_governed_records
# covers: architecture.memory_ontology.memory_and_provenance_link_to_governed_records_through_typed_relations
# covers: architecture.run_governance.run_is_preferred_execution_record

@prefix jcp: <https://jido.run/ontology/control-plane#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jcp: a owl:Ontology ;
    rdfs:label "Jido Governed Control-Plane Ontology" ;
    rdfs:comment "A companion ontology that models Jido.Code product records as first-class semantic entities so repository memory, workflow provenance, source-code findings, and embedded control-plane storage can link to managed repositories, operations, orchestration, governance, conversations, execution runtime, auth, security, setup, and external provider records directly." ;
    owl:versionInfo "2026-07-05" .

### Classes

jcp:GovernedRecord a owl:Class ;
    rdfs:label "Governed Record" ;
    rdfs:comment "A durable product-owned control-plane record in Jido.Code." ;
    rdfs:subClassOf prov:Entity .

jcp:ManagedRepo a owl:Class ;
    rdfs:label "Managed Repository" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:SourceRepo a owl:Class ;
    rdfs:label "Source Repository" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Project a owl:Class ;
    rdfs:label "Legacy Project" ;
    rdfs:comment "A legacy project record retained for compatibility while managed repositories are canonical." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Intake a owl:Class ;
    rdfs:label "Intake" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:ExternalObject a owl:Class ;
    rdfs:label "External Object" ;
    rdfs:comment "An external provider object such as a GitHub issue or pull request tracked by the control plane." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:WorkItem a owl:Class ;
    rdfs:label "Work Item" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Run a owl:Class ;
    rdfs:label "Run" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:WorkflowRun a owl:Class ;
    rdfs:label "Workflow Run" ;
    rdfs:comment "A previous-era workflow run record retained as compatibility input for canonical governed runs." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:ExecutionProfile a owl:Class ;
    rdfs:label "Execution Profile" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Evidence a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:ChangeRequest a owl:Class ;
    rdfs:label "Change Request" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Decision a owl:Class ;
    rdfs:label "Governed Decision" ;
    rdfs:comment "A governed control-plane decision record, distinct from memory:Decision." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:PolicySet a owl:Class ;
    rdfs:label "Policy Set" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:ReviewPolicy a owl:Class ;
    rdfs:label "Review Policy" ;
    rdfs:comment "An embedded governance policy concept projected from policy sets when review controls need first-class semantic links." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:RepoPosture a owl:Class ;
    rdfs:label "Repository Posture" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:PostureCheck a owl:Class ;
    rdfs:label "Posture Check" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Conversation a owl:Class ;
    rdfs:label "Conversation" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:ConversationEvent a owl:Class ;
    rdfs:label "Conversation Event" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:ConversationSnapshot a owl:Class ;
    rdfs:label "Conversation Snapshot" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:ExecutionWorkflow a owl:Class ;
    rdfs:label "Execution Workflow" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:SandboxSession a owl:Class ;
    rdfs:label "Sandbox Session" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:RuntimeEvent a owl:Class ;
    rdfs:label "Runtime Event" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:Checkpoint a owl:Class ;
    rdfs:label "Checkpoint" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:ExecSession a owl:Class ;
    rdfs:label "Execution Session" ;
    rdfs:comment "Execution session projection keeps command status, bounded output summaries, artifact references, and cost or duration metadata; unbounded command output is intentionally excluded from semantic literals." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:SpriteSpec a owl:Class ;
    rdfs:label "Sprite Spec" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:AccountRecord a owl:Class ;
    rdfs:label "Account Record" ;
    rdfs:comment "A local identity or credential-adjacent record owned by the product control plane." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:User a owl:Class ;
    rdfs:label "User" ;
    rdfs:subClassOf jcp:AccountRecord .

jcp:UserIdentity a owl:Class ;
    rdfs:label "User Identity" ;
    rdfs:subClassOf jcp:AccountRecord .

jcp:ApiKey a owl:Class ;
    rdfs:label "API Key" ;
    rdfs:comment "API key projection excludes raw key material and key hashes; only lifecycle and relationship metadata should be represented." ;
    rdfs:subClassOf jcp:AccountRecord .

jcp:Token a owl:Class ;
    rdfs:label "Token" ;
    rdfs:comment "Token projection excludes bearer token values and other credential material; only bounded lifecycle metadata should be represented." ;
    rdfs:subClassOf jcp:AccountRecord .

jcp:ProviderConfig a owl:Class ;
    rdfs:label "Provider Config" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:GitHubRepo a owl:Class ;
    rdfs:label "GitHub Repository" ;
    rdfs:comment "GitHub repository projection excludes webhook secrets and other provider credentials." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:WebhookDelivery a owl:Class ;
    rdfs:label "Webhook Delivery" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:IssueAnalysis a owl:Class ;
    rdfs:label "Issue Analysis" ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:SecurityRecord a owl:Class ;
    rdfs:label "Security Record" ;
    rdfs:comment "A product-owned security metadata record. Secret material itself should remain outside semantic projection." ;
    rdfs:subClassOf jcp:GovernedRecord .

jcp:SecretRef a owl:Class ;
    rdfs:label "Secret Reference" ;
    rdfs:comment "Secret reference projection excludes plaintext values, ciphertext, password hashes, API key hashes, token values, webhook secrets, and private keys." ;
    rdfs:subClassOf jcp:SecurityRecord .

jcp:SecretLifecycleAudit a owl:Class ;
    rdfs:label "Secret Lifecycle Audit" ;
    rdfs:subClassOf jcp:SecurityRecord .

jcp:SystemConfig a owl:Class ;
    rdfs:label "System Config" ;
    rdfs:subClassOf jcp:GovernedRecord .

### Object properties

jcp:forManagedRepo a owl:ObjectProperty ;
    rdfs:label "for managed repo" ;
    rdfs:comment "Scopes a governed record to its canonical managed repository." ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range jcp:ManagedRepo .

jcp:sourceRepo a owl:ObjectProperty ;
    rdfs:label "source repo" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range jcp:SourceRepo .

jcp:legacyProject a owl:ObjectProperty ;
    rdfs:label "legacy project" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range jcp:Project .

jcp:tracksExternalObject a owl:ObjectProperty ;
    rdfs:label "tracks external object" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range jcp:ExternalObject .

jcp:fromIntake a owl:ObjectProperty ;
    rdfs:label "from intake" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range jcp:Intake .

jcp:observesExternalObject a owl:ObjectProperty ;
    rdfs:label "observes external object" ;
    rdfs:domain jcp:Observation ;
    rdfs:range jcp:ExternalObject .

jcp:aboutEvent a owl:ObjectProperty ;
    rdfs:label "about event" ;
    rdfs:domain jcp:Observation ;
    rdfs:range jcp:Event .

jcp:informedByObservation a owl:ObjectProperty ;
    rdfs:label "informed by observation" ;
    rdfs:domain jcp:Assessment ;
    rdfs:range jcp:Observation .

jcp:informedByEvent a owl:ObjectProperty ;
    rdfs:label "informed by event" ;
    rdfs:domain jcp:Assessment ;
    rdfs:range jcp:Event .

jcp:informedByExternalObject a owl:ObjectProperty ;
    rdfs:label "informed by external object" ;
    rdfs:domain jcp:Assessment ;
    rdfs:range jcp:ExternalObject .

jcp:derivedFromAssessment a owl:ObjectProperty ;
    rdfs:label "derived from assessment" ;
    rdfs:domain jcp:WorkItem ;
    rdfs:range jcp:Assessment .

jcp:derivedFromObservation a owl:ObjectProperty ;
    rdfs:label "derived from observation" ;
    rdfs:domain jcp:WorkItem ;
    rdfs:range jcp:Observation .

jcp:derivedFromExternalObject a owl:ObjectProperty ;
    rdfs:label "derived from external object" ;
    rdfs:domain jcp:WorkItem ;
    rdfs:range jcp:ExternalObject .

jcp:executesWorkItem a owl:ObjectProperty ;
    rdfs:label "executes work item" ;
    rdfs:domain jcp:Run ;
    rdfs:range jcp:WorkItem .

jcp:projectsWorkflowRun a owl:ObjectProperty ;
    rdfs:label "projects workflow run" ;
    rdfs:comment "Links a canonical governed run to a compatibility workflow run record." ;
    rdfs:domain jcp:Run ;
    rdfs:range jcp:WorkflowRun .

jcp:usesExecutionProfile a owl:ObjectProperty ;
    rdfs:label "uses execution profile" ;
    rdfs:domain jcp:Run ;
    rdfs:range jcp:ExecutionProfile .

jcp:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence" ;
    rdfs:domain jcp:Run ;
    rdfs:range jcp:Evidence .

jcp:hasChangeRequest a owl:ObjectProperty ;
    rdfs:label "has change request" ;
    rdfs:domain jcp:Run ;
    rdfs:range jcp:ChangeRequest .

jcp:hasDecision a owl:ObjectProperty ;
    rdfs:label "has decision" ;
    rdfs:domain jcp:Run ;
    rdfs:range jcp:Decision .

jcp:reviewsEvidence a owl:ObjectProperty ;
    rdfs:label "reviews evidence" ;
    rdfs:domain jcp:Decision ;
    rdfs:range jcp:Evidence .

jcp:supersedesDecision a owl:ObjectProperty ;
    rdfs:label "supersedes governed decision" ;
    rdfs:domain jcp:Decision ;
    rdfs:range jcp:Decision .

jcp:hasPolicySet a owl:ObjectProperty ;
    rdfs:label "has policy set" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range jcp:PolicySet .

jcp:hasReviewPolicy a owl:ObjectProperty ;
    rdfs:label "has review policy" ;
    rdfs:domain jcp:PolicySet ;
    rdfs:range jcp:ReviewPolicy .

jcp:hasRepoPosture a owl:ObjectProperty ;
    rdfs:label "has repository posture" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range jcp:RepoPosture .

jcp:hasPostureCheck a owl:ObjectProperty ;
    rdfs:label "has posture check" ;
    rdfs:domain jcp:RepoPosture ;
    rdfs:range jcp:PostureCheck .

jcp:algedonicCheck a owl:ObjectProperty ;
    rdfs:label "algedonic check" ;
    rdfs:domain jcp:RepoPosture ;
    rdfs:range jcp:PostureCheck .

jcp:hasConversation a owl:ObjectProperty ;
    rdfs:label "has conversation" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range jcp:Conversation .

jcp:conversationForWorkItem a owl:ObjectProperty ;
    rdfs:label "conversation for work item" ;
    rdfs:domain jcp:Conversation ;
    rdfs:range jcp:WorkItem .

jcp:hasConversationEvent a owl:ObjectProperty ;
    rdfs:label "has conversation event" ;
    rdfs:domain jcp:Conversation ;
    rdfs:range jcp:ConversationEvent .

jcp:hasConversationSnapshot a owl:ObjectProperty ;
    rdfs:label "has conversation snapshot" ;
    rdfs:domain jcp:Conversation ;
    rdfs:range jcp:ConversationSnapshot .

jcp:hasExecutionWorkflow a owl:ObjectProperty ;
    rdfs:label "has execution workflow" ;
    rdfs:domain jcp:SandboxSession ;
    rdfs:range jcp:ExecutionWorkflow .

jcp:hasSandboxSession a owl:ObjectProperty ;
    rdfs:label "has sandbox session" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range jcp:SandboxSession .

jcp:hasRuntimeEvent a owl:ObjectProperty ;
    rdfs:label "has runtime event" ;
    rdfs:domain jcp:SandboxSession ;
    rdfs:range jcp:RuntimeEvent .

jcp:hasCheckpoint a owl:ObjectProperty ;
    rdfs:label "has checkpoint" ;
    rdfs:domain jcp:SandboxSession ;
    rdfs:range jcp:Checkpoint .

jcp:hasExecSession a owl:ObjectProperty ;
    rdfs:label "has execution session" ;
    rdfs:domain jcp:SandboxSession ;
    rdfs:range jcp:ExecSession .

jcp:usesSpriteSpec a owl:ObjectProperty ;
    rdfs:label "uses sprite spec" ;
    rdfs:domain jcp:SandboxSession ;
    rdfs:range jcp:SpriteSpec .

jcp:belongsToUser a owl:ObjectProperty ;
    rdfs:label "belongs to user" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range jcp:User .

jcp:identifiesProviderAccount a owl:ObjectProperty ;
    rdfs:label "identifies provider account" ;
    rdfs:domain jcp:UserIdentity ;
    rdfs:range jcp:ProviderConfig .

jcp:tracksGitHubRepo a owl:ObjectProperty ;
    rdfs:label "tracks GitHub repository" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range jcp:GitHubRepo .

jcp:deliveredToGitHubRepo a owl:ObjectProperty ;
    rdfs:label "delivered to GitHub repository" ;
    rdfs:domain jcp:WebhookDelivery ;
    rdfs:range jcp:GitHubRepo .

jcp:analyzesGitHubRepo a owl:ObjectProperty ;
    rdfs:label "analyzes GitHub repository" ;
    rdfs:domain jcp:IssueAnalysis ;
    rdfs:range jcp:GitHubRepo .

jcp:hasSecretRef a owl:ObjectProperty ;
    rdfs:label "has secret reference" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range jcp:SecretRef .

jcp:hasSecretLifecycleAudit a owl:ObjectProperty ;
    rdfs:label "has secret lifecycle audit" ;
    rdfs:domain jcp:SecretRef ;
    rdfs:range jcp:SecretLifecycleAudit .

### Datatype properties

jcp:recordId a owl:DatatypeProperty ;
    rdfs:label "record id" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:recordKind a owl:DatatypeProperty ;
    rdfs:label "record kind" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:recordStatus a owl:DatatypeProperty ;
    rdfs:label "record status" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:insertedAt a owl:DatatypeProperty ;
    rdfs:label "inserted at" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:dateTime .

jcp:updatedAt a owl:DatatypeProperty ;
    rdfs:label "updated at" ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:dateTime .

jcp:metadataJson a owl:DatatypeProperty ;
    rdfs:label "metadata JSON" ;
    rdfs:comment "A bounded serialized projection for map-shaped metadata that has not been promoted into first-class semantic nodes." ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:payloadJson a owl:DatatypeProperty ;
    rdfs:label "payload JSON" ;
    rdfs:comment "A bounded serialized projection for external payloads that are retained for traceability but not queried as semantic structure. Raw secrets, ciphertext, key hashes, private keys, bearer tokens, raw LLM responses, and unbounded command output must not use this predicate." ;
    rdfs:domain jcp:GovernedRecord ;
    rdfs:range xsd:string .

jcp:managedRepoId a owl:DatatypeProperty ;
    rdfs:label "managed repo id" ;
    rdfs:domain jcp:ManagedRepo ;
    rdfs:range xsd:string .

jcp:sourceRepoId a owl:DatatypeProperty ;
    rdfs:label "source repo id" ;
    rdfs:domain jcp:SourceRepo ;
    rdfs:range xsd:string .

jcp:projectId a owl:DatatypeProperty ;
    rdfs:label "project id" ;
    rdfs:domain jcp:Project ;
    rdfs:range xsd:string .

jcp:intakeId a owl:DatatypeProperty ;
    rdfs:label "intake id" ;
    rdfs:domain jcp:Intake ;
    rdfs:range xsd:string .

jcp:externalObjectId a owl:DatatypeProperty ;
    rdfs:label "external object id" ;
    rdfs:domain jcp:ExternalObject ;
    rdfs:range xsd:string .

jcp:eventId a owl:DatatypeProperty ;
    rdfs:label "event id" ;
    rdfs:domain jcp:Event ;
    rdfs:range xsd:string .

jcp:observationId a owl:DatatypeProperty ;
    rdfs:label "observation id" ;
    rdfs:domain jcp:Observation ;
    rdfs:range xsd:string .

jcp:assessmentId a owl:DatatypeProperty ;
    rdfs:label "assessment id" ;
    rdfs:domain jcp:Assessment ;
    rdfs:range xsd:string .

jcp:workItemId a owl:DatatypeProperty ;
    rdfs:label "work item id" ;
    rdfs:domain jcp:WorkItem ;
    rdfs:range xsd:string .

jcp:runId a owl:DatatypeProperty ;
    rdfs:label "run id" ;
    rdfs:domain jcp:Run ;
    rdfs:range xsd:string .

jcp:workflowRunId a owl:DatatypeProperty ;
    rdfs:label "workflow run id" ;
    rdfs:domain jcp:WorkflowRun ;
    rdfs:range xsd:string .

jcp:executionProfileId a owl:DatatypeProperty ;
    rdfs:label "execution profile id" ;
    rdfs:domain jcp:ExecutionProfile ;
